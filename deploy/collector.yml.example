# Optional override file for the collector, read from /etc/ghstats/collector.yml
# by the systemd unit. Anything omitted here falls back to the jar defaults.
ghstats:
  collector:
    owners:
      - dualfroz
      - VulCodeCom
      - Sinlege
    authorEmails:
      - me@dualfroz.com
      - me@dualfroz.com
      - 284081405+dualfroz@users.noreply.github.com
    # Repos where EVERY commit counts regardless of author (matched by bare name
    # or owner/name). Use for backdated/prank repos with uncertain author mail.
    fullCountRepos: []
    # Manual offset added to totals.own_commits, for history removed later that
    # you still want reflected. Keep at 0 unless you know you need it.
    baselineCommits: 0
    # Merge tokei language variants into one; drop non-code/data formats.
    languageAliases:
      Tsx: TypeScript
      Jsx: JavaScript
      C Header: C
      C/C++ Header: C
      C++ Header: C++
    languageDenylist:
      - JSON
      - YAML
      - TOML
      - Markdown
      - Plain Text
      - SVG
      - XML
      - INI
      - Dotenv
      - CSV
    reposRoot: /srv/ghstats/repos
    snapshotPath: /srv/ghstats/data/snapshot.json
    numstatTimeoutSeconds: 300
    calendarDays: 371
    topReposCount: 12
