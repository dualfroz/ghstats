# Collector image (OPTIONAL). Enumerates repos, clones/pulls, computes stats,
# writes snapshot.json. Needs git, gh and tokei plus GitHub auth at runtime.
#
# The recommended deploy runs the collector on the HOST via a systemd timer,
# because the host already has gh logged in and git configured. This image is
# provided for hosts that prefer containerised runs; supply GitHub auth with
# GH_TOKEN or by mounting a logged-in gh config into /home/ghstats/.config/gh.

ARG GH_VERSION=2.55.0
ARG TOKEI_VERSION=12.1.2

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml .
COPY ghstats-common/pom.xml ghstats-common/pom.xml
COPY ghstats-collector/pom.xml ghstats-collector/pom.xml
COPY ghstats-server/pom.xml ghstats-server/pom.xml
RUN mvn -q -B -pl ghstats-collector -am dependency:go-offline
COPY ghstats-common/src ghstats-common/src
COPY ghstats-collector/src ghstats-collector/src
RUN mvn -q -B -pl ghstats-collector -am -DskipTests package

FROM eclipse-temurin:21-jre AS runtime
ARG GH_VERSION
ARG TOKEI_VERSION
RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ca-certificates \
    && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
        | tar -xz -C /tmp \
    && install -m 0755 "/tmp/gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh \
    && curl -fsSL "https://github.com/XAMPPRocky/tokei/releases/download/v${TOKEI_VERSION}/tokei-x86_64-unknown-linux-gnu.tar.gz" \
        | tar -xz -C /usr/local/bin tokei \
    && rm -rf /tmp/gh_* /var/lib/apt/lists/*
RUN groupadd --system ghstats && useradd --system --gid ghstats --home /home/ghstats --create-home ghstats
WORKDIR /home/ghstats
COPY --from=build /workspace/ghstats-collector/target/ghstats-collector.jar collector.jar
USER ghstats
ENTRYPOINT ["java", "-jar", "collector.jar"]
